{
  "name": "nihongo-learning-app",
  "private": true,
  "version": "0.2.0",
  "description": "Japanese learning application, offline alpha",
  "author": "Команда 日本語",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --config vite.config.ts",
    "build": "tsc -b && vite build --configLoader native --config vite.config.ts && node scripts/prepare-pwa.mjs",
    "desktop": "electron .",
    "build:windows": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "sync:mobile": "pnpm build && cap sync",
    "preview": "vite preview --configLoader native --config vite.config.ts",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/core.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ts-fsrs": "^5.4.2",
    "vite": "latest"
  },
  "pnpm": {"ignoredBuiltDependencies": ["electron-winstaller"]},
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "latest"
  }
}
